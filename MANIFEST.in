include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SKILL.md
include requirements.txt
include pyproject.toml

# Documentation ships with the source distribution so an offline copy of the
# project is self-explanatory.
recursive-include docs *.md
recursive-include tools *.py *.yml

# Examples are part of the deliverable: the HTML sources, their built decks and
# the screenshots referenced from the README.
recursive-include examples *.html *.pptx *.png
recursive-include examples/charts *.py
recursive-include tests *.py

global-exclude *.py[cod] __pycache__ .DS_Store Thumbs.db
